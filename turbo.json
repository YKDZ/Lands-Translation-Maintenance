{
  "boundaries": {
    "tags": {
      "library": {
        "dependencies": {
          "allow": ["library"]
        }
      }
    }
  },
  "globalPassThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"],
  "tasks": {
    "//#boundaries": {
      "tags": ["quality:light"]
    },
    "//#check": {
      "tags": ["quality:entry"]
    },
    "//#check:full": {
      "tags": ["quality:entry"]
    },
    "//#check:heavy": {
      "tags": ["quality:entry"]
    },
    "//#check:l10n": {
      "dependsOn": [
        "@lands-l10n/l10n#build",
        "@lands-l10n/l10n#build:minimessage"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".l10n/config.yml",
        ".l10n/lock.json",
        ".l10n/upstream/source-baseline.json",
        ".l10n/exceptions.yml",
        "Locale/**",
        "Modules/**",
        "categories.yml",
        "levels.yml",
        "roles.yml"
      ],
      "outputs": [],
      "tags": ["quality:heavy"]
    },
    "//#fix": {
      "tags": ["work:repair"]
    },
    "//#format:check": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#format:write": {
      "cache": false,
      "dependsOn": ["//#lint:fix"],
      "tags": ["work:repair"]
    },
    "//#lint": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#lint:fix": {
      "cache": false,
      "tags": ["work:repair"]
    },
    "//#typecheck": {
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
