{
  "boundaries": {
    "tags": {
      "library": {
        "dependencies": {
          "allow": ["library"]
        }
      }
    }
  },
  "tasks": {
    "//#boundaries": {
      "tags": ["quality:light"]
    },
    "//#check": {
      "tags": ["quality:entry"]
    },
    "//#check:full": {
      "tags": ["quality:entry"]
    },
    "//#check:heavy": {
      "tags": ["quality:entry"]
    },
    "//#check:l10n": {
      "dependsOn": [
        "@lands-l10n/l10n#build",
        "@lands-l10n/l10n#build:minimessage"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "translations/zhcn/.lioni/project.yml",
        "translations/zhcn/.lioni/lioni.config.ts",
        "translations/zhcn/.lioni/lioni.baseline.json",
        "translations/zhcn/.lioni/lioni.exceptions.yaml",
        "translations/zhcn/.lioni/source/current.json",
        "translations/zhcn/.lioni/source/snapshots/**",
        "translations/zhcn/.lioni/terms/**",
        "translations/zhcn/Locale/**",
        "translations/zhcn/Modules/**",
        "translations/zhcn/categories.yml",
        "translations/zhcn/roles.yml"
      ],
      "outputs": [],
      "tags": ["quality:heavy"]
    },
    "//#fix": {
      "tags": ["work:repair"]
    },
    "//#format:check": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#format:write": {
      "cache": false,
      "dependsOn": ["//#lint:fix"],
      "tags": ["work:repair"]
    },
    "//#lint": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#lint:fix": {
      "cache": false,
      "tags": ["work:repair"]
    },
    "//#l10n:update": {
      "cache": false,
      "dependsOn": ["@lands-l10n/l10n#build"],
      "outputs": [],
      "tags": ["work:on-demand"]
    },
    "//#l10n:publish": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "GITHUB_ACTIONS",
        "GITHUB_EVENT_NAME",
        "GITHUB_REF",
        "GITHUB_SHA",
        "GITHUB_WORKFLOW_REF",
        "GH_TOKEN"
      ],
      "tags": ["work:release"]
    },
    "//#test:l10n-publication": {
      "dependsOn": ["@lands-l10n/l10n#build"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/tooling-config/package.json",
        "packages/tooling-config/base.json",
        "packages/tooling-config/node.json"
      ],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#test:task-gates": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#l10n:export": {
      "cache": false,
      "outputs": [],
      "tags": ["work:preparation"]
    },
    "//#test:l10n-update": {
      "dependsOn": ["@lands-l10n/l10n#build"],
      "outputs": [],
      "tags": ["quality:light"]
    }
  },
  "globalDependencies": [
    "packages/tooling-config/oxfmt.config.ts",
    "packages/tooling-config/oxlint.config.ts"
  ]
}
