{
  "name": "@lands-l10n/l10n",
  "private": true,
  "files": [
    "dist/**",
    "target/minimessage/**"
  ],
  "type": "module",
  "imports": {
    "#/*": {
      "source": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    "./lioni.config": {
      "source": "./lioni.config.ts",
      "types": "./lioni.config.ts",
      "default": "./lioni.config.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false && chmod +x dist/cli.js",
    "build:minimessage": "node --conditions=source scripts/build-minimessage.ts",
    "source:prepare": "node --conditions=source scripts/prepare-lioni-source.ts",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "test": "node --conditions=source --test --test-reporter=spec --test-reporter=./scripts/node-test-count-reporter.ts --test-reporter-destination=stdout --test-reporter-destination=stderr 'test/*.test.ts'",
    "test:minimessage": "node --conditions=source --test --test-reporter=spec --test-reporter=./scripts/node-test-count-reporter.ts --test-reporter-destination=stdout --test-reporter-destination=stderr 'test/minimessage/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@lioni/lioni": "0.2.0",
    "fflate": "0.8.3",
    "parse5": "8.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lands-l10n/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "24"
  }
}
