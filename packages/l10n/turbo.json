{
  "extends": ["//"],
  "tags": ["library"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test/**",
        "!scripts/**",
        "$TURBO_ROOT$/packages/typescript-config/base.json"
      ],
      "outputs": ["dist/**"],
      "tags": ["quality:light"]
    },
    "build:minimessage": {
      "inputs": [
        "java/minimessage/**",
        "scripts/build-minimessage.ts",
        "minimessage-dependencies.json"
      ],
      "outputs": ["target/minimessage/**"],
      "tags": ["work:preparation"]
    },
    "source:prepare": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "tags": ["work:on-demand"]
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "test:minimessage": {
      "dependsOn": ["build", "build:minimessage"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "java/minimessage/**",
        "minimessage-dependencies.json"
      ],
      "outputs": [],
      "tags": ["quality:heavy"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/typescript-config/base.json"
      ],
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
